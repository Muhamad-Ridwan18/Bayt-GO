{
  "expo": {
    "name": "BaytGo",
    "slug": "baytgo",
    "scheme": "baytgo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F8FAFC"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "id.baytgo.app",
      "associatedDomains": [
        "applinks:baytgo.id",
        "applinks:www.baytgo.id",
        "applinks:staging.baytgo.id"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "id.baytgo.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "baytgo.id", "pathPrefix": "/" },
            { "scheme": "https", "host": "www.baytgo.id", "pathPrefix": "/" },
            { "scheme": "https", "host": "staging.baytgo.id", "pathPrefix": "/" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "adaptiveIcon": {
        "backgroundColor": "#1A3D34",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-dev-client",
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#1A3D34"
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "4e261915-6790-48c7-b247-33d56c5c1cfe"
      }
    },
    "owner": "mrdwn1812"
  }
}
